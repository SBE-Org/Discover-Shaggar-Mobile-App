# Copy to .env for local development. On Render, set these under Environment instead.

# MongoDB connection string. MongoDB Atlas (free M0 cluster) gives you one like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/discover-shaggar?retryWrites=true&w=majority
# Local MongoDB: mongodb://127.0.0.1:27017/discover-shaggar
# "memory" runs without a database (data is lost on restart; for quick tests only).
MONGODB_URI=mongodb://127.0.0.1:27017/discover-shaggar
# Database name, if it is not in the connection string.
# MONGODB_DB=discover-shaggar

PORT=8080
# NODE_ENV=production

# Long random value used to hash visitor IP addresses in suggestions.
IP_SALT=change-me-to-a-long-random-string

# First administrator, created on start if there is none yet. Remove the password afterwards.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-password-123
# ADMIN_NAME=Your Name

# 1 = load the clearly-labelled sample data on start (test deployments only).
SEED_DEMO=0

# Daily automatic backup into MongoDB (0 turns it off) and how many to keep.
# AUTO_BACKUP=1
# BACKUPS_KEPT=5

# Only if the frontend calls the API directly instead of through the Vercel rewrites:
# CORS_ORIGINS=https://your-app.vercel.app

# Map tiles (defaults are free providers with attribution).
# TILE_STREET=
# TILE_SAT=
